{
  "manifest_version": 3,
  "name": "QB Gate 浏览器助手",
  "version": "0.2.0",
  "minimum_chrome_version": "116",
  "description": "联动 QB Gate：出口 IP 没核实时拦下受保护的网站（默认 Claude 官方网站），其他网站不受影响。",
  "key": "",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "declarativeNetRequest",
    "storage",
    "alarms",
    "activeTab",
    "scripting",
    "cookies",
    "privacy",
    "proxy"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "*://*.claude.ai/*",
    "*://*.claude.com/*",
    "*://*.anthropic.com/*",
    "*://*.claudeusercontent.com/*"
  ],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "content_scripts": [
    {
      "matches": ["http://127.0.0.1/*"],
      "js": ["claim.js"],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "QB Gate 浏览器助手",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'"
  },
  "incognito": "spanning"
}
