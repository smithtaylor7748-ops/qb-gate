{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "QB Gate",
  "version": "0.22.6",
  "identifier": "com.qbgate.panel",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "QB Gate",
        "width": 1320,
        "height": 940,
        "minWidth": 680,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "resources": {
      "../LICENSE": "licenses/LICENSE",
      "../ATTRIBUTION.md": "licenses/ATTRIBUTION.md",
      "../THIRD_PARTY_NOTICES.txt": "licenses/THIRD_PARTY_NOTICES.txt",
      "../docs/dependencies.json": "licenses/dependencies.json"
    },
    "shortDescription": "Local AI client workspace",
    "license": "GPL-3.0-or-later"
  }
}
